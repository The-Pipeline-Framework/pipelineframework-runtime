<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.pipelineframework.it</groupId>
    <artifactId>hosted-rest-worker-command-app</artifactId>
    <version>1.0.0</version>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.55.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>3.39.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-amazon-services-bom</artifactId>
                <version>3.39.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.pipelineframework.it</groupId>
            <artifactId>hosted-rest-worker-command-provider</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.pipelineframework</groupId>
            <artifactId>pipelineframework</artifactId>
            <version>@project.version@</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-amazon-lambda-http</artifactId>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>pipeline.yaml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.pipelineframework.it</groupId>
                            <artifactId>hosted-rest-worker-command-provider</artifactId>
                            <version>1.0.0</version>
                        </path>
                        <path>
                            <groupId>org.pipelineframework</groupId>
                            <artifactId>pipelineframework-compiler</artifactId>
                            <version>@tpf.compiler.version@</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Apipeline.config=${project.basedir}/pipeline.yaml</arg>
                        <arg>-Apipeline.generatedSourcesDir=${project.build.directory}/generated-sources/pipeline</arg>
                        <arg>-Apipeline.module=${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-generated-command</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <proc>none</proc>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.build.directory}/generated-sources/pipeline/orchestrator-client</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>3.39.2</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework-release-maven-plugin</artifactId>
                <version>@project.version@</version>
                <configuration>
                    <skip>false</skip>
                    <releaseVersion>rest-worker-command-release-1</releaseVersion>
                    <compiledTruthArtifactId>worker</compiledTruthArtifactId>
                    <artifacts>
                        <artifact>
                            <artifactId>worker</artifactId>
                            <kind>lambda-zip</kind>
                            <file>${project.build.directory}/function.zip</file>
                            <uri>maven:org.pipelineframework.it:hosted-rest-worker-command-app:zip:1.0.0</uri>
                            <stepIds>
                                <stepId>Echo</stepId>
                            </stepIds>
                            <capabilities>
                                <capability>local</capability>
                                <capability>rest</capability>
                                <capability>grpc</capability>
                                <capability>sqs</capability>
                            </capabilities>
                        </artifact>
                    </artifacts>
                    <deployment>
                        <profile>aws-durable-java21-rest-worker-v1</profile>
                        <bindings>
                            <binding>
                                <bindingId>command-effects</bindingId>
                                <capability>aws:dynamodb:command-effects</capability>
                            </binding>
                        </bindings>
                        <entries>
                            <entry>
                                <entryId>worker</entryId>
                                <artifactId>worker</artifactId>
                                <runtimeId>hosted-rest-worker-command-app</runtimeId>
                                <packagePath>.</packagePath>
                                <entryPackagePath>lib/io.quarkus.quarkus-amazon-lambda-http-3.39.2.jar</entryPackagePath>
                                <entryClass>io.quarkus.amazon.lambda.http.LambdaHttpHandler</entryClass>
                                <trigger>AWS_DURABLE_REST_WORKER</trigger>
                                <bindingIds>
                                    <bindingId>command-effects</bindingId>
                                </bindingIds>
                            </entry>
                        </entries>
                        <check>
                            <entryId>worker</entryId>
                            <timeoutMillis>30000</timeoutMillis>
                            <input>
                                <payloadTypeId>com.example.echo.EchoInput</payloadTypeId>
                                <payloadEncoding>application/tpf-transition+json</payloadEncoding>
                                <payload>{"value":"hello"}</payload>
                            </input>
                            <expectedResult>
                                <payloadTypeId>com.example.echo.EchoOutput</payloadTypeId>
                                <payloadEncoding>application/tpf-transition+json</payloadEncoding>
                                <payload>{"value":"hello"}</payload>
                            </expectedResult>
                        </check>
                    </deployment>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate-release-descriptor</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
